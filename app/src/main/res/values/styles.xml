<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base theme. Always dark: this is a video client. -->
    <style name="Theme.YTPro" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/brand_red</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/brand_red</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Splash: opaque window so there is no white flash on cold start. -->
    <style name="Theme.YTPro.Splash" parent="Theme.YTPro">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- WebView host: the immersive flags are toggled at runtime for video. -->
    <style name="Theme.YTPro.Fullscreen" parent="Theme.YTPro">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <style name="Theme.YTPro.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/brand_red</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <style name="SettingsHeading">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="SettingsValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <style name="SettingsButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

</resources>
